package org.shrek2.research;
import java.lang.reflect.*;
public class UnifiedActivityTest {
 static long time=1000000000;static FrontendActivity app;static MenuSurface surface;static OriginalMenu menu;
 static Object field(String n)throws Exception{Field f=SessionActivity.class.getDeclaredField(n);f.setAccessible(true);return f.get(app);}
 static Object af(Object o,String n)throws Exception{Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);return f.get(o);}
 static void check(boolean v,String s){if(!v)throw new AssertionError(s);}
 static void frames(int n){for(int i=0;i<n;i++){time+=16666667;android.view.Choreographer.getInstance().frame(time);}}
 static void button(int b,boolean down)throws Exception{Method m=SessionActivity.class.getDeclaredMethod("routeButton",int.class,boolean.class,int.class);m.setAccessible(true);m.invoke(app,b,down,-b);}
 static void press(int b)throws Exception{button(b,true);button(b,false);frames(40);}
 static void call(String n)throws Exception{Method m=SessionActivity.class.getDeclaredMethod(n);m.setAccessible(true);m.invoke(app);}
 static android.media.AudioTrack track(String name)throws Exception{return (android.media.AudioTrack)af(af(field("audio"),name),"track");}
 static int soundCount(int id){int n=0;for(int played:android.media.SoundPool.played)if(played==id)n++;return n;}
 static void letter(int b)throws Exception{int before=soundCount(63);press(b);check(soundCount(63)==before+1,"initials navigation sound must reach SoundPool once");}
 static boolean dialogue()throws Exception{Method m=SessionActivity.class.getDeclaredMethod("isDialogueActive",long.class);m.setAccessible(true);return (Boolean)m.invoke(null,(Long)field("session"));}
